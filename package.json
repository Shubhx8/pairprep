{
  "name": "pairprep",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative interview and pair-programming platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run --workspace=packages/shared build",
    "build": "npm run build:shared && npm run --workspaces --if-present build",
    "dev:server": "npm run --workspace=apps/server dev",
    "dev:web": "npm run --workspace=apps/web dev",
    "dev": "npm run dev:server",
    "typecheck": "npm run build:shared && npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
