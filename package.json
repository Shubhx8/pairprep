{
  "name": "pairprep",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative interview and pair-programming platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run --workspace=packages/shared build",
    "build": "npm run build:shared && npm run --workspaces --if-present build",
    "dev:server": "npm run --workspace=apps/server dev",
    "dev:web": "npm run --workspace=apps/web dev",
    "dev": "npm run dev:server",
    "typecheck": "npm run build:shared && npm run --workspaces --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:test:up": "docker compose -f infra/docker-compose.test.yml up -d",
    "db:test:down": "docker compose -f infra/docker-compose.test.yml down -v",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.50.1",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">= 22.22.2"
  },
  "overrides": {
    "body-parser": "1.20.9"
  }
}
