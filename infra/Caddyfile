{
    admin off
}

{$SITE_ADDRESS:http://localhost} {
    encode gzip

    # Security headers (HSTS in production only)
    @https {
        protocol https
    }
    header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Reverse proxy API, healthcheck, and real-time WebSocket routes to internal api service
    @api {
        path /api/* /healthz /socket.io/* /sync*
    }
    handle @api {
        reverse_proxy api:3000
    }

    # Everything else is served as a static SPA with client-side routing fallback
    handle {
        root * /srv/web

        # Hashed assets can be cached aggressively for 1 year
        @assets {
            path /assets/*
        }
        header @assets Cache-Control "public, max-age=31536000, immutable"

        # index.html must never be cached to ensure instantaneous updates
        @index {
            path / /index.html
        }
        header @index Cache-Control "no-cache, no-store, must-revalidate"

        try_files {path} /index.html
        file_server
    }
}
